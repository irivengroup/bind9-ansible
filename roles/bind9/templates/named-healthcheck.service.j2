[Unit]
Description=Bind9Project authoritative DNS healthcheck
After=named.service
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/named-healthcheck {{ bind_back_ip }}{% for zone in (bind_managed_zones | default(bind_authoritative_zones | default([], true), true)) %} {{ zone.domain }}{% endfor %}
User=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
