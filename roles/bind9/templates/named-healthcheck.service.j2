[Unit]
Description=Bind9-Ansible authoritative DNS healthcheck
After=named.service
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/named-healthcheck {{ bind_back_ip }} {{ (bind_managed_zones | default(bind_authoritative_zones | default([], true), true)) | map(attribute='domain') | join(' ') }}
User=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
