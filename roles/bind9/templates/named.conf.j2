{# Single canonical RHEL 8+ BIND configuration; zone data remains in /var/named. #}
{% set primary_role = (bind_primary_group | default("dns_primary")) in group_names %}
{% set local_front_acl = "bind_primary_front_ip" if primary_role else "bind_secondary_front_ip" %}
{% set local_back_acl = "bind_primary_back_ip" if primary_role else "bind_secondary_back_ip" %}
{% set validation_mode = bind_dnssec_active | default(false) | string | lower %}
{% set dnssec_mode = 'auto' if validation_mode == 'auto' else ('yes' if validation_mode == 'true' else 'no') %}
{% set client_networks = bind_allowed_clients %}
{% set cloud_networks = bind_cloud_clients | default([], true) %}
{% set internal_networks = bind_internal_clients | default([], true) %}
key "{{ bind_tsig_key_name }}" {
    algorithm {{ bind_tsig_algorithm }};
    secret "{{ bind_tsig_secret }}";
};

// Administrative control uses the separate vendor-generated key, never site TSIG.
include "/etc/rndc.key";

// Exact IPv4 loopback, shared by listener and access rules.
acl "local_loopback" {
    127.0.0.1;
};

// Peer addresses belong to the current environment/site, never the whole inventory.
acl "bind_primary_back_ip" {
    {{ hostvars[bind_primary_host].bind_back_ip }};
};
acl "bind_secondary_back_ip" {
    {{ hostvars[bind_secondary_host].bind_back_ip }};
};
// Only the local FRONT address is consumed by this server's destination rules.
acl "{{ local_front_acl }}" {
    {{ bind_front_ip }};
};
acl "bind_servers_back_ip" {
    bind_primary_back_ip;
    bind_secondary_back_ip;
};
{% if client_networks %}
acl "allowed_clients" {
{% for cidr in client_networks %}    {{ cidr }};
{% endfor %}};
{% endif %}

// Shared source authorization; destination policy follows declared client lists.
// Without views, source and destination ACLs do not enforce a source/interface pair.
acl "dns_query_clients" {
    local_loopback;
    bind_servers_back_ip;
{% if client_networks %}
    allowed_clients;
{% endif %}
};
acl "dns_recursive_clients" {
    // DNS peers and the transfer key must not open recursive service.
    !bind_servers_back_ip;
    !key "{{ bind_tsig_key_name }}";
    local_loopback;
{% if client_networks %}
    allowed_clients;
{% endif %}
};

controls {
    inet 127.0.0.1 port 953 allow { local_loopback; } keys { "rndc-key"; };
};

options {
    directory "/var/named";
    // Paths and logging follow the distribution's native EL8 named.conf.
    dump-file "/var/named/data/cache_dump.db";
    statistics-file "/var/named/data/named_stats.txt";
    memstatistics-file "/var/named/data/named_mem_stats.txt";
    secroots-file "/var/named/data/named.secroots";
    recursing-file "/var/named/data/named.recursing";
    pid-file "/run/named/named.pid";
    session-keyfile "/run/named/session.key";
    listen-on port 53 { local_loopback; {{ local_front_acl }}; {{ local_back_acl }}; };
    listen-on-v6 { none; };
    allow-query { dns_query_clients; };
    allow-query-on {
        local_loopback;
        {{ local_front_acl }};
        {{ local_back_acl }};
    };
    recursion yes;
    allow-recursion { dns_recursive_clients; };
    allow-query-cache { dns_recursive_clients; };
    allow-recursion-on {
        local_loopback;
{% if cloud_networks %}
        {{ local_front_acl }};
{% endif %}
{% if internal_networks %}
        {{ local_back_acl }};
{% endif %}
    };
    allow-query-cache-on {
        local_loopback;
{% if cloud_networks %}
        {{ local_front_acl }};
{% endif %}
{% if internal_networks %}
        {{ local_back_acl }};
{% endif %}
    };
    allow-transfer { none; };
    allow-update { none; };
    notify no;
    transfer-source {{ bind_back_ip }};
    notify-source {{ bind_back_ip }};
    dnssec-validation {{ dnssec_mode }};
{% if dnssec_mode != 'no' %}
{% if dnssec_mode == 'auto' %}
    bindkeys-file "/etc/named.root.key";
{% endif %}
    managed-keys-directory "/var/named/dynamic";
{% endif %}
    empty-zones-enable yes;
    minimal-responses yes;
    version "not disclosed";
    include "/etc/crypto-policies/back-ends/bind.config";
};

logging {
    channel default_debug {
        file "data/named.run";
        severity dynamic;
    };
};

{% if dnssec_mode == 'yes' %}
// Explicit vendor-managed trust anchors for manual validation mode on EL8.
include "/etc/named.root.key";
{% endif %}
// Keep distribution-owned native definitions and data unchanged.
include "/etc/named.rfc1912.zones";

{% for auth_zone in (bind_managed_zones | default(bind_authoritative_zones | default([], true), true)) %}
zone "{{ auth_zone.domain }}" IN {
{% if primary_role %}
    type master;
    file "/var/named/zones/{{ auth_zone.domain }}.zone";
    // Nested ACL: secondary BACK source AND site TSIG, on this server's listeners.
    allow-transfer { !{ !bind_secondary_back_ip; any; }; key "{{ bind_tsig_key_name }}"; };
    notify explicit;
    also-notify { {{ hostvars[bind_secondary_host].bind_back_ip }} key "{{ bind_tsig_key_name }}"; };
{% else %}
    type slave;
    file "slaves/{{ auth_zone.domain }}.zone";
    masters { {{ hostvars[bind_primary_host].bind_back_ip }} key "{{ bind_tsig_key_name }}"; };
    allow-notify { !{ !bind_primary_back_ip; any; }; key "{{ bind_tsig_key_name }}"; };
{% endif %}
};
{% endfor %}

// Preserve the existing private DNS policy for undeclared names.
zone "." IN {
    type master;
    file "/var/named/empty-root.zone";
};

{% for zone in bind_forward_zones | default([], true) %}
{% if dnssec_mode != 'no' and not (zone.dnssec_validate | default(true)) %}
// Bind9-Ansible DNSSEC-PRIVATE {{ zone.domain | lower }}
{% endif %}
zone "{{ zone.domain }}" IN {
    type forward;
    forward only;
    forwarders {
{% for server in zone.forwarders %}
        {{ server.address }} port {{ server.port | default(53) }};
{% endfor %}
    };
};
{% endfor %}
