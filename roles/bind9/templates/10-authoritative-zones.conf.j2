{% for auth_zone in bind_authoritative_zones %}
zone "{{ auth_zone.domain }}" IN {
{% if bind_role == 'primary' %}
    type primary;
    file "/var/named/zones/{{ auth_zone.domain }}.zone";
    allow-update { none; };
    allow-transfer { key "{{ bind_tsig_name }}"; };
    notify explicit;
    also-notify { {{ bind_secondary_back_ip }} key "{{ bind_tsig_name }}"; };
{% else %}
    type secondary;
    file "slaves/{{ auth_zone.domain }}.zone";
    primaries { {{ bind_primary_back_ip }} key "{{ bind_tsig_name }}"; };
    transfer-source {{ bind_back_ip }};
    allow-transfer { none; };
    allow-notify { {{ bind_primary_back_ip }}; };
{% endif %}
};
{% endfor %}
zone "." IN {
    type primary;
    file "/var/named/empty-root.zone";
    allow-transfer { none; };
};
