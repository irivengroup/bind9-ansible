; Bind9-Ansible-MANAGED-ZONE
; Bind9-Ansible-MANAGED-REVERSE
$TTL {{ auth_zone.ttl | default(300, true) }}
@ IN SOA ns1.{{ bind_authoritative_zones[0].domain }}. hostmaster.{{ bind_authoritative_zones[0].domain }}. ( {{ auth_zone.serial }} 3600 900 1209600 300 )
@ IN NS ns1.{{ bind_authoritative_zones[0].domain }}.
@ IN NS ns2.{{ bind_authoritative_zones[0].domain }}.
{% for record in auth_zone.records | default([], true) %}
{{ record.name }} IN PTR {{ record.value }}
{% endfor %}
{# Reverse authorities need the same cuts for explicitly forwarded children. #}
{% for delegation in auth_zone.domain | forward_delegations(bind_managed_zones | default(bind_authoritative_zones), bind_forward_zones | default([])) %}
{% for server in delegation.servers %}
{{ delegation.domain }} IN NS {{ server.name }}
{{ server.name }} IN {{ server.type }} {{ server.address }}
{% endfor %}
{% endfor %}
