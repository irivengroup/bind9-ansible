+
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Static predicate context, independent of runtime hits. Only the left side
+ * of &&/|| is necessarily tested; its right side inherits its parent's demand.
+ * A sequential list similarly tests only its final result. Explicit [[ ]]
+ * predicates retain their separately observed native condition-node inventory.
+ */
+/* Closed source review, not a generic dynamic-command exception. */
+static int qa_closed_boolean_head(const COMMAND *command, const char *name)
+{
+  const WORD_LIST *words;
+  unsigned index;
+  static const char *const flags[] = {
+    "$ambiguous", "$DIRECTLY", "$required", "$usable", "$acceptable",
+    "$directly", "$PARTIAL", "$COVERED", "$profile_covered", "$via",
+    "$inverse", "$CHANGED_RESULT", "$MUTATING", "$PREPARED", "$DEFER"
+  };
+  if (strcmp(source_digest,"735a0ba1dc0080b85b650aae54940ed754f87075c0a0bf7242fe24b3407c0b85") ||
+      command->type != cm_simple) return 0;
+  words = command->value.Simple->words;
+  if (!words || words->next) return 0;
+  for (index = 0; index < sizeof(flags) / sizeof(flags[0]); index++)
+    if (!strcmp(name,flags[index])) return 1;
+  return 0;
+}
+
+static void qa_boolean_tree(const COMMAND *command, int truth, unsigned depth)
+{
+  const WORD_LIST *words;
+  const PATTERN_LIST *clause;
+  const char *name;
+  QA_ORIGIN *origin;
+  int reason = 0;
+  char record[320];
+  if (!command || qa_functions_mode || (qa_entries_mode && !qa_decisions_mode)) return;
+  if (depth > 2048) { dropped = 1; return; }
+  origin = qa_origin_lookup(command, 0);
+  if (!origin) { dropped = 1; return; }
+  switch (command->type) {
+    case cm_simple:
+      words = command->value.Simple->words;
+      while (words && (words->word->flags & W_ASSIGNMENT)) words = words->next;
+      name = words ? words->word->word : "";
+      if (strpbrk(name, "$`\\\"'" ) && !qa_closed_boolean_head(command,name)) reason = 4;
+      else if (!strcmp(name,"trap")) {
+        if (!qa_closed_trap_command(command,origin->identity)) reason = 5;
+      } else if (!strcmp(name,"exec")) {
+        /* Without a command WORD, exec only changes this shell's redirects.
+         * A replacement executable still has no closed source inventory. */
+        if (words->next) reason = 5;
+      } else if (!strcmp(name, "eval") || !strcmp(name, "source") || !strcmp(name, ".") ||
+                 !strcmp(name, "enable")) reason = 5;
+      if (!truth || reason) break;
+      origin->status_predicate = 1;
+      snprintf(record, sizeof(record), "B9\tI\t%ld\t%s\t%d\t%d\t%s\n",
+               (long)getpid(), source_digest, origin->line, origin->kind, origin->identity);
+      write_event(record);
+      break;
+    case cm_connection:
+      switch (command->value.Connection->connector) {
+        case AND_AND: case OR_OR:
+          qa_boolean_tree(command->value.Connection->first, 1, depth + 1);
+          qa_boolean_tree(command->value.Connection->second, truth, depth + 1);
+          break;
+        case ';': case '\n':
+          qa_boolean_tree(command->value.Connection->first, 0, depth + 1);
+          qa_boolean_tree(command->value.Connection->second, truth, depth + 1);
+          break;
+        case '|':
+          if (truth) {
+            snprintf(record, sizeof(record), "B9\tI\t%ld\t%s\t%d\t%d\t%s\n",
+                     (long)getpid(), source_digest, origin->line, origin->kind, origin->identity);
+            write_event(record);
+          }
+          qa_boolean_tree(command->value.Connection->first, 0, depth + 1);
+          qa_boolean_tree(command->value.Connection->second, 0, depth + 1);
+          break;
+        default: reason = 6; break;
+      }
+      break;
+    case cm_if:
+      qa_boolean_tree(command->value.If->test, 1, depth + 1);
+      qa_boolean_tree(command->value.If->true_case, truth, depth + 1);
+      qa_boolean_tree(command->value.If->false_case, truth, depth + 1);
+      break;
+    case cm_while: case cm_until:
+      qa_boolean_tree(command->value.While->test, 1, depth + 1);
+      qa_boolean_tree(command->value.While->action, 0, depth + 1);
+      break;
+    case cm_for:
+      qa_boolean_tree(command->value.For->action, 0, depth + 1);
+      break;
+    case cm_function_def:
+      qa_boolean_tree(command->value.Function_def->command, 0, depth + 1);
+      break;
+    case cm_group: qa_boolean_tree(command->value.Group->command, truth, depth + 1); break;
+    case cm_subshell: qa_boolean_tree(command->value.Subshell->command, truth, depth + 1); break;
+    case cm_case:
+      /* The selected arm determines a tested case command's final status.
+       * Pattern predicates and selected arms already have their own native
+       * B4/B6 inventory. Arm bodies retain their internal boolean decisions. */
+      if (truth) {
+        snprintf(record, sizeof(record), "B9\tI\t%ld\t%s\t%d\t%d\t%s\n",
+                 (long)getpid(), source_digest, origin->line, origin->kind, origin->identity);
+        write_event(record);
+      }
+      for (clause = command->value.Case->clauses; clause; clause = clause->next)
+        qa_boolean_tree(clause->action, 0, depth + 1);
+      break;
+    case cm_arith:
+      qa_arithmetic_command_purpose(command->value.Arith->exp,origin,
+        "arithmetic:expression",truth ? 1 : 0);
+      break;
+    case cm_arith_for:
+      qa_arithmetic_command_purpose(command->value.ArithFor->init,origin,"arithmetic:init",2);
+      qa_arithmetic_command_purpose(command->value.ArithFor->test,origin,"arithmetic:test",3);
+      qa_arithmetic_command_purpose(command->value.ArithFor->step,origin,"arithmetic:step",4);
+      if (truth) {
+        snprintf(record,sizeof(record),"B9\tI\t%ld\t%s\t%d\t%d\t%s\n",
+          (long)getpid(),source_digest,origin->line,origin->kind,origin->identity);
+        write_event(record);
+      }
+      qa_boolean_tree(command->value.ArithFor->action,0,depth+1);
+      break;
+    case cm_cond: break;
+    default: reason = 3; break;
+  }
+  if (reason) {
+    snprintf(record, sizeof(record), "B9\tU\t%ld\t%s\t%d\t%d\t%d\n",
+             (long)getpid(), source_digest, origin->line, origin->kind, reason);
+    write_event(record);
+  }
+}
+
+
+/* A substitution is parsed once with its authored location and again by native
+ * parse_and_execute in the forked shell. Bind only an exact, unique whole-tree
+ * fingerprint previously inventoried from this source; ambiguity fails closed.
+ * No text search, expansion, parser invocation or synthetic hit is used. */
+typedef struct qa_substitution_origin {
+  char shape[65], identity[65];
+  unsigned ambiguous, lexical_count, owner_rank;
+  unsigned lexical_tags[QA_OWNER_ANCESTORS];
+  char owner[65];
+} QA_SUBSTITUTION_ORIGIN;
+static QA_SUBSTITUTION_ORIGIN qa_substitutions[4096];
+static unsigned qa_substitution_count;
+
+/* Bind only real retained native WORD objects. Nested substitutions keep
+ * their nearest retained lexical ancestor; discarded array-element tokens may
+ * legitimately leave their enclosing assignment as the retained owner.
+ * Runtime expansion contexts are NOT implemented by this static experiment.
+ */
+static void qa_source_word(const WORD_DESC *word, const char *parent, const char *edge)
+{
+  QA_ORIGIN *origin;
+  QA_SUBSTITUTION_ORIGIN *site;
+  unsigned index, rank;
+  char owner[65], record[400];
+  if (!word) return;
+  origin = qa_origin_lookup((const COMMAND *)word, 0);
+  if (!origin || origin->kind != -1 || !origin->lexical_tag) return;
+  if (!qa_edge_digest(parent, edge, owner)) { dropped = 1; return; }
+  if (origin->identity[0] && strcmp(origin->identity, owner)) { dropped = 1; return; }
+  memcpy(origin->identity, owner, 65);
+  if (!qa_name_digest(word->word, origin->word_digest)) { dropped = 1; return; }
+  qa_lexical_expansions_bind(origin, owner);
+  for (index = 0; index < qa_substitution_count; index++) {
+    site = &qa_substitutions[index];
+    for (rank = 1; rank <= site->lexical_count; rank++) {
+      if (site->lexical_tags[rank - 1] != origin->lexical_tag || rank < site->owner_rank) continue;
+      if (rank == site->owner_rank && site->owner[0] && strcmp(site->owner, owner)) { dropped = 1; continue; }
+      if (rank == site->owner_rank && !strcmp(site->owner, owner)) continue;
+      memcpy(site->owner, owner, 65);
+      site->owner_rank = rank;
+      snprintf(record, sizeof(record), "W1\tI\t%ld\t%s\t%s\t%s\t%s\t%u\n",
+               (long)getpid(), source_digest, site->identity, owner, site->shape, rank);
+      write_event(record);
+    }
+  }
+}
+
+static void qa_source_word_list(const WORD_LIST *words, const char *parent, const char *prefix)
+{
+  unsigned index = 0;
+  char edge[96];
+  for (; words; words = words->next, index++) {
+    if (index == 100000) { dropped = 1; return; }
+    snprintf(edge, sizeof(edge), "%s:word:%u", prefix, index);
+    qa_source_word(words->word, parent, edge);
+  }
+}
+
+static void qa_source_redirections(const REDIRECT *redirect, const char *parent, const char *prefix)
+{
+  unsigned index = 0;
+  char edge[96];
+  for (; redirect; redirect = redirect->next, index++) {
+    if (index == 100000) { dropped = 1; return; }
+    if (redirect->rflags & REDIR_VARASSIGN) {
+      snprintf(edge, sizeof(edge), "%s:%u:source", prefix, index);
+      qa_source_word(redirect->redirector.filename, parent, edge);
+    }
+    switch (redirect->instruction) {
+      case r_duplicating_input: case r_duplicating_output:
+      case r_move_input: case r_move_output: case r_close_this: break;
+      case r_reading_until: case r_deblank_reading_until: case r_reading_string:
+      case r_output_direction: case r_appending_to: case r_input_direction:
+      case r_inputa_direction: case r_err_and_out: case r_append_err_and_out:
+      case r_input_output: case r_output_force: case r_duplicating_input_word:
+      case r_duplicating_output_word: case r_move_input_word: case r_move_output_word:
+        snprintf(edge, sizeof(edge), "%s:%u:target", prefix, index);
+        qa_source_word(redirect->redirectee.filename, parent, edge); break;
+      default: dropped = 1; break;
+    }
+  }
+}
+
+static void qa_source_condition_words(const COND_COM *condition, const char *parent, unsigned depth)
+{
+  char child[65];
+  if (!condition) return;
+  if (depth > 2048) { dropped = 1; return; }
+  qa_source_word(condition->op, parent, "condition:word");
+  if (!qa_edge_digest(parent, "condition:left", child)) { dropped = 1; return; }
+  qa_source_condition_words(condition->left, child, depth + 1);
+  if (!qa_edge_digest(parent, "condition:right", child)) { dropped = 1; return; }
+  qa_source_condition_words(condition->right, child, depth + 1);
+}
+
+static void qa_source_words(const COMMAND *command, const char *parent, unsigned depth)
+{
+  const PATTERN_LIST *clause;
+  unsigned index;
+  char edge[64];
+  qa_source_redirections(command->redirects, parent, "command:redirect");
+  switch (command->type) {
+    case cm_simple:
+      qa_source_word_list(command->value.Simple->words, parent, "simple");
+      qa_source_redirections(command->value.Simple->redirects, parent, "simple:redirect"); break;
+    case cm_for:
+      qa_source_word(command->value.For->name, parent, "for:name");
+      qa_source_word_list(command->value.For->map_list, parent, "for:map"); break;
+    case cm_select:
+      qa_source_word(command->value.Select->name, parent, "select:name");
+      qa_source_word_list(command->value.Select->map_list, parent, "select:map"); break;
+    case cm_case:
+      qa_source_word(command->value.Case->word, parent, "case:value");
+      for (clause = command->value.Case->clauses, index = 0; clause; clause = clause->next, index++) {
+        snprintf(edge, sizeof(edge), "case:clause:%u", index);
+        qa_source_word_list(clause->patterns, parent, edge);
+      }
+      break;
+    case cm_function_def: qa_source_word(command->value.Function_def->name, parent, "function:name"); break;
+    case cm_cond: qa_source_condition_words(command->value.Cond, parent, depth + 1); break;
+    case cm_arith: qa_source_word_list(command->value.Arith->exp, parent, "arithmetic"); break;
+    case cm_arith_for:
+      qa_source_word_list(command->value.ArithFor->init, parent, "arithmetic:init");
+      qa_source_word_list(command->value.ArithFor->test, parent, "arithmetic:test");
+      qa_source_word_list(command->value.ArithFor->step, parent, "arithmetic:step"); break;
+    default: break;
+  }
+}
+
+static int qa_substitution_shape(const COMMAND *command, char *digest)
+{
+  EVP_MD_CTX *context = EVP_MD_CTX_new();
+  unsigned char value[32];
+  unsigned length;
+  int good;
+  qa_ast_bytes = qa_ast_nodes = 0;
+  qa_ast_error = 0;
+  good = context && EVP_DigestInit_ex(context, EVP_sha256(), NULL) &&
+    qa_ast_tree(context, command, 0) && EVP_DigestFinal_ex(context, value, &length) && length == 32;
+  if (context) EVP_MD_CTX_free(context);
+  if (good) hex_digest(value, digest);
+  return good;
+}
+
+static void qa_substitution_register(const COMMAND *command, const char *identity)
+{
+  char shape[65];
+  unsigned index, cursor, ambiguous = 0;
+  if (!qa_substitution_shape(command, shape)) { dropped = 1; return; }
+  for (index = 0; index < qa_substitution_count; index++) {
+    if (strcmp(qa_substitutions[index].identity, identity) == 0) return;
+    if (strcmp(qa_substitutions[index].shape, shape) == 0) {
+      qa_substitutions[index].ambiguous = 1;
+      ambiguous = 1;
+      if (!qa_entries_mode) return; /* Preserve the existing restricted modes. */
+    }
+  }
+  if (qa_substitution_count == 4096) { dropped = 1; return; }
+  memcpy(qa_substitutions[index].shape, shape, 65);
+  memcpy(qa_substitutions[index].identity, identity, 65);
+  qa_substitutions[index].ambiguous = ambiguous;
+  if (qa_entries_mode) {
+    if (!qa_lexical_depth || qa_lexical_depth > QA_OWNER_ANCESTORS) { dropped = 1; return; }
+    qa_substitutions[index].lexical_count = qa_lexical_depth;
+    for (cursor = 0; cursor < qa_lexical_depth; cursor++)
+      qa_substitutions[index].lexical_tags[cursor] = qa_lexical_frames[cursor];
+  }
+  qa_substitution_count++;
+}
+
+static void qa_inventory_root(const COMMAND *, int, int, int);
+
+void qa_substitution_rebind(const COMMAND *command, const char *from_file)
+{
+  int saved_errno = errno;
+  char shape[65], record[320];
+  unsigned index, selected = 4096, matches = 0;
+  initialize();
+  if (active && command && from_file && qa_entries_mode && qa_trap_rebind(command, from_file)) goto done;
+  if (!active || !command || !from_file || strcmp(from_file, "command substitution") ||
+      !(subshell_environment & SUBSHELL_COMSUB)) goto done;
+  if (qa_substitution_shape(command, shape)) {
+    for (index = 0; index < qa_substitution_count; index++) {
+      if (strcmp(qa_substitutions[index].shape, shape)) continue;
+      if (qa_entries_mode) {
+        if (!qa_expansion_depth || !qa_expansion_owners[qa_expansion_depth - 1][0] ||
+            strcmp(qa_substitutions[index].owner, qa_expansion_owners[qa_expansion_depth - 1])) continue;
+        selected = index; matches++;
+      } else {
+        if (qa_substitutions[index].ambiguous) break;
+        qa_inventory_tree(command, qa_substitutions[index].identity, 0);
+        qa_boolean_tree(command, 0, 0);
+        goto done;
+      }
+    }
+  }
+  if (qa_entries_mode && matches == 1) {
+    int binding = qa_rebinding;
+    qa_rebinding = 1;
+    qa_inventory_tree(command, qa_substitutions[selected].identity, 0);
+    qa_rebinding = binding;
+    goto done;
+  }
+  if (qa_functions_mode) {
+    /* Repeated substitutions may have no unique command origin. Parse
+     * the ENTIRE native subtree with a distinct, unreviewed identity.
+     * No functions means no function facts; any function declaration
+     * is emitted and must be rejected by the source-pinned profile.
+     * The full profile retains its original strict refusal below. */
+    qa_inventory_root(command, 2, qa_ast_line(command, 0), 0);
+    goto done;
+  }
+  dropped = 1;
+  snprintf(record, sizeof(record), "B2\tX\t%ld\t%s\t7\t%d\t%d\n",
+           (long)getpid(), source_digest, command->type, qa_ast_line(command, 0));
+  write_event(record);
+done:
+  errno = saved_errno;
+}
+
+static void qa_inventory_root(const COMMAND *command, int kind, int line, int column)
+{
+  int saved_errno = errno;
+  EVP_MD_CTX *context;
+  unsigned char value[32];
+  unsigned length;
+  char digest[65];
+  initialize();
+  if (active && command) {
+    qa_ast_bytes = qa_ast_nodes = 0;
+    qa_ast_error = 0;
+    /* Hash the complete tree once. Structural paths distinguish equal
+     * commands on one line without repeatedly re-hashing every subtree. */
+    context = EVP_MD_CTX_new();
+    if (!context || !EVP_DigestInit_ex(context, EVP_sha256(), NULL) ||
+        !qa_integer(context, kind) || !qa_integer(context, line) || !qa_integer(context, column) ||
+        !qa_ast_tree(context, command, 0) || !EVP_DigestFinal_ex(context, value, &length) || length != 32) {
+      dropped = 1;
+      {
+        char record[320];
+        snprintf(record, sizeof(record), "B2\tX\t%ld\t%s\t%d\t%d\t%d\n", (long)getpid(), source_digest,
+                 qa_ast_error ? qa_ast_error : 7, command->type, qa_ast_line(command, 0));
+        write_event(record);
+      }
+    } else {
+      hex_digest(value, digest);
+      if (kind == 1) qa_substitution_register(command, digest);
+      qa_inventory_tree(command, digest, 0);
+      qa_boolean_tree(command, 0, 0);
+    }
+    if (context) EVP_MD_CTX_free(context);
+  }
+  errno = saved_errno;
+}
+
+void qa_ast_inventory(const COMMAND *command)
+{
+  if (!qa_parsing_trap && !(qa_entries_mode && qa_expansion_depth))
+    qa_inventory_root(command, 0, qa_ast_line(command, 0), 0);
+}
+
+void qa_ast_inventory_substitution(const COMMAND *command, int line, int column)
+{
+  if (!qa_parsing_trap && !(qa_entries_mode && (qa_expansion_depth || (parser_state & PST_STRING))))
+    qa_inventory_root(command, 1, line, column);
+}
