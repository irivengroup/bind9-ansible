+/* Shared native grammar inventory: caller supplies a proven source root,
+ * not a shell value or a generated expression. This emits no runtime hits. */
+static void qa_arithmetic_expression_inventory(const char *source, const char *owner, int line)
+{
+  int result = 2, saved_errno = errno;
+  char record[320];
+  if (!qa_decisions_mode || !source) return;
+  if (line <= 0 || qa_arithmetic_owner[0]) { dropped = 1; return; }
+  begin_unwind_frame("qa_arithmetic_inventory");
+  add_unwind_protect(qa_arithmetic_inventory_cleanup, (char *)NULL);
+  memcpy(qa_arithmetic_owner,owner,65); qa_arithmetic_line = line;
+  qa_arithmetic_syntax = qa_arithmetic_static_text(source);
+  qa_arithmetic_ast_active = 1;
+  if (qa_arithmetic_syntax) result = qa_arithmetic_parse_only(qa_arithmetic_syntax);
+  qa_arithmetic_ast_finish(result);
+  snprintf(record,sizeof(record),"A1\tP\t%ld\t%s\t%s\t%d\t%d\n",
+    (long)getpid(),source_digest,owner,line,result);
