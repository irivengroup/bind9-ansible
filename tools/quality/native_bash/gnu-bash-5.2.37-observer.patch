+  int result = 0;
+  if (context && EVP_DigestInit_ex(context,EVP_sha256(),NULL) &&
+      EVP_DigestUpdate(context,input,length) && EVP_DigestUpdate(context,"",1) &&
+      EVP_DigestFinal_ex(context,digest,&size) && size == 32) {
+    hex_digest(digest,output); result = 1;
+  }
+  if (context) EVP_MD_CTX_free(context);
+  return result;
