+    output[used++] = '0';
+    at = end;
+  }
+  output[used] = 0; qa_arithmetic_offsets[used] = (int)length;
+  qa_arithmetic_length = used;
+  return output;
+unsupported:
+  free(output); free(qa_arithmetic_offsets);
+  qa_arithmetic_offsets = NULL; qa_arithmetic_length = 0;
+  return NULL;
+}
