+ */
+#define QA_EVENT_SET_CAPACITY 65536U
+#define QA_EVENT_SET_LIMIT 32768U
+typedef struct qa_event_key {
+  uint64_t fingerprint;
+  unsigned used;
+  char key[320];
+} QA_EVENT_KEY;
+static QA_EVENT_KEY qa_event_keys[QA_EVENT_SET_CAPACITY];
