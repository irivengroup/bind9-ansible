+static int qa_event_duplicate(const char *event)
+{
+  const char *payload;
+  char key[320];
+  uint64_t fingerprint = UINT64_C(14695981039346656037);
+  unsigned index, position, count;
+  size_t length;
+  int arithmetic, parameter;
+  /* Headers, exits and unattributed/unsupported diagnostics are never folded.
+   * PID is provenance, not part of a global unit/outcome's coverage identity. */
+  arithmetic = event[0] == 'A' && ((event[1] == '1' && strchr("IPR", event[3]) != NULL) ||
+      (event[1] == '2' && strchr("ITVG", event[3]) != NULL) ||
+      (event[1] == '4' && event[3] == 'I'));
+  parameter = event[0] == 'P' && event[1] == '4' && strchr("ICR",event[3]) != NULL;
+  if ((event[0] != 'B' && !arithmetic && !parameter) || event[2] != '\t' || event[4] != '\t' ||
+      !(arithmetic || parameter || (event[1] >= '1' && event[1] <= '4' && strchr("ICSFRA", event[3])) ||
+        (event[1] == '6' && event[3] == 'P') ||
+        (event[1] == '7' && event[3] == 'D') ||
+        (event[1] == '8' && (event[3] == 'R' || event[3] == 'O')) ||
+        (event[1] == '9' && event[3] == 'I'))) return 0;
+  if (event[0] == 'A' && event[1] == '2' && event[3] == 'G') {
+    /* Keep PID for evaluation completion only. A2V remains a global unit /
+     * outcome set, while each writing process supplies its own valid root. */
+    payload = event + 5;
+  } else {
+    payload = strchr(event + 5, '\t');
+    if (!payload) return -1;
+    payload++;
+  }
+  length = strlen(payload);
+  if (length + 5 >= sizeof(key)) return -1;
+  memcpy(key, event, 5);
+  memcpy(key + 5, payload, length + 1);
+  for (position = 0; position < length + 5; position++) {
+    fingerprint ^= (unsigned char)key[position];
+    fingerprint *= UINT64_C(1099511628211);
+  }
+  index = (unsigned)fingerprint % QA_EVENT_SET_CAPACITY;
+  for (count = 0; count < QA_EVENT_SET_CAPACITY; count++, index = (index + 1) % QA_EVENT_SET_CAPACITY) {
+    if (qa_event_keys[index].used) {
+      if (qa_event_keys[index].fingerprint == fingerprint && strcmp(qa_event_keys[index].key, key) == 0) return 1;
+    } else {
+      if (qa_event_key_count >= QA_EVENT_SET_LIMIT) return -1;
+      qa_event_keys[index].fingerprint = fingerprint;
+      memcpy(qa_event_keys[index].key, key, length + 6);
+      qa_event_keys[index].used = 1;
+      qa_event_key_count++;
+      return 0;
+    }
+  }
+  return -1;
+}
