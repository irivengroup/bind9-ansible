+    origin = qa_origin_lookup((const COMMAND *)clause, 0);
+    if (origin) {
+      for (cursor = clause->patterns, index = 0; cursor && cursor != pattern && index < 100000; cursor = cursor->next) index++;
+      if (cursor != pattern || index >= 100000) { dropped = 1; errno = saved_errno; return; }
+      snprintf(edge, sizeof(edge), "case:pattern:%d", index);
