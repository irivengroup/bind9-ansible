+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * QA-only GNU Bash 5.2.37 AST inventory. No expansions or printers are called.
+ * This prototype does not claim full trap/arithmetic/AWK or runtime coverage.
+ * Included into the independently inspected socket observer translation unit.
+ */
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Research-only conditional identities use native structural paths, not text
+ * matching. Two equal predicates on one line remain two independent sites.
+ */
+static int qa_edge_digest(const char *parent, const char *edge, char output[65])
+{
+  EVP_MD_CTX *context = EVP_MD_CTX_new();
+  unsigned char digest[32];
+  unsigned length;
+  int result = 0;
+  if (context && EVP_DigestInit_ex(context, EVP_sha256(), NULL) &&
+      EVP_DigestUpdate(context, parent, strlen(parent) + 1) &&
+      EVP_DigestUpdate(context, edge, strlen(edge) + 1) &&
+      EVP_DigestFinal_ex(context, digest, &length) && length == 32) {
+    hex_digest(digest, output);
+    result = 1;
+  }
+  if (context) EVP_MD_CTX_free(context);
+  return result;
+}
