+static unsigned long qa_ast_bytes, qa_ast_nodes;
+static int qa_ast_error;
+
+static int qa_bytes(EVP_MD_CTX *context, const void *data, size_t length)
+{
+  qa_ast_bytes += length;
+  if (qa_ast_bytes > 67108864UL) { qa_ast_error = 1; return 0; }
+  return EVP_DigestUpdate(context, data, length) == 1;
+}
+
+static int qa_integer(EVP_MD_CTX *context, int value)
+{
+  char buffer[32];
+  int size = snprintf(buffer, sizeof(buffer), "%d:", value);
+  return size > 0 && (size_t)size < sizeof(buffer) && qa_bytes(context, buffer, (size_t)size);
+}
+
+static int qa_word(EVP_MD_CTX *context, const WORD_DESC *word)
+{
+  const char *text = word && word->word ? word->word : "";
+  return qa_bytes(context, text, strlen(text) + 1);
+}
+
+static int qa_words(EVP_MD_CTX *context, const WORD_LIST *words)
+{
+  while (words) {
+    if (!qa_word(context, words->word)) return 0;
+    words = words->next;
+  }
+  return qa_integer(context, -1);
+}
+
+static int qa_redirects(EVP_MD_CTX *context, const REDIRECT *redirect)
+{
+  for (; redirect; redirect = redirect->next) {
+    if (!qa_integer(context, redirect->instruction)) return 0;
+    if (redirect->rflags & REDIR_VARASSIGN) {
+      if (!qa_word(context, redirect->redirector.filename)) return 0;
+    } else if (!qa_integer(context, redirect->redirector.dest)) return 0;
+    switch (redirect->instruction) {
+      case r_duplicating_input: case r_duplicating_output:
+      case r_move_input: case r_move_output: case r_close_this:
+        if (!qa_integer(context, redirect->redirectee.dest)) return 0;
+        break;
+      case r_reading_until: case r_deblank_reading_until: case r_reading_string:
+      case r_output_direction: case r_appending_to: case r_input_direction:
+      case r_inputa_direction: case r_err_and_out: case r_append_err_and_out:
+      case r_input_output: case r_output_force: case r_duplicating_input_word:
+      case r_duplicating_output_word: case r_move_input_word: case r_move_output_word:
+        if (!qa_word(context, redirect->redirectee.filename)) return 0;
+        break;
+      default: qa_ast_error = 4; return 0;
+    }
+  }
+  return qa_integer(context, -1);
+}
+
+static int qa_cond_tree(EVP_MD_CTX *context, const COND_COM *condition, unsigned depth)
+{
+  if (!condition) return qa_integer(context, -1);
+  if (depth > 2048) { qa_ast_error = 2; return 0; }
+  return qa_integer(context, condition->type) && qa_integer(context, condition->flags & CMD_INVERT_RETURN) && qa_word(context, condition->op) &&
+         qa_cond_tree(context, condition->left, depth + 1) && qa_cond_tree(context, condition->right, depth + 1);
+}
+
+static int qa_ast_tree(EVP_MD_CTX *context, const COMMAND *command, unsigned depth)
+{
+  const PATTERN_LIST *pattern;
+  if (!command) return qa_integer(context, -1);
+  if (depth > 2048) { qa_ast_error = 2; return 0; }
+  if (++qa_ast_nodes > 100000) { qa_ast_error = 3; return 0; }
+  if (!qa_integer(context, command->type) || !qa_integer(context, command->flags & CMD_INVERT_RETURN) ||
+      !qa_redirects(context, command->redirects)) return 0;
+  switch (command->type) {
+    case cm_simple:
+      return qa_words(context, command->value.Simple->words) && qa_redirects(context, command->value.Simple->redirects);
+    case cm_connection:
+      return qa_integer(context, command->value.Connection->connector) &&
+             qa_ast_tree(context, command->value.Connection->first, depth + 1) &&
+             qa_ast_tree(context, command->value.Connection->second, depth + 1);
+    case cm_for:
+      return qa_word(context, command->value.For->name) && qa_words(context, command->value.For->map_list) &&
+             qa_ast_tree(context, command->value.For->action, depth + 1);
+    case cm_select:
+      return qa_word(context, command->value.Select->name) && qa_words(context, command->value.Select->map_list) &&
+             qa_ast_tree(context, command->value.Select->action, depth + 1);
+    case cm_while: case cm_until:
+      return qa_ast_tree(context, command->value.While->test, depth + 1) &&
+             qa_ast_tree(context, command->value.While->action, depth + 1);
+    case cm_if:
+      return qa_ast_tree(context, command->value.If->test, depth + 1) &&
+             qa_ast_tree(context, command->value.If->true_case, depth + 1) &&
+             qa_ast_tree(context, command->value.If->false_case, depth + 1);
+    case cm_case:
+      if (!qa_word(context, command->value.Case->word)) return 0;
+      for (pattern = command->value.Case->clauses; pattern; pattern = pattern->next)
+        if (!qa_words(context, pattern->patterns) || !qa_integer(context, pattern->flags) ||
+            !qa_ast_tree(context, pattern->action, depth + 1)) return 0;
+      return qa_integer(context, -1);
+    case cm_function_def:
+      return qa_word(context, command->value.Function_def->name) &&
+             qa_ast_tree(context, command->value.Function_def->command, depth + 1);
+    case cm_group: return qa_ast_tree(context, command->value.Group->command, depth + 1);
+    case cm_subshell: return qa_ast_tree(context, command->value.Subshell->command, depth + 1);
+    case cm_coproc: return qa_ast_tree(context, command->value.Coproc->command, depth + 1);
+    case cm_arith: return qa_words(context, command->value.Arith->exp);
+    case cm_arith_for:
+      return qa_words(context, command->value.ArithFor->init) && qa_words(context, command->value.ArithFor->test) &&
+             qa_words(context, command->value.ArithFor->step) && qa_ast_tree(context, command->value.ArithFor->action, depth + 1);
+    case cm_cond: return qa_cond_tree(context, command->value.Cond, depth + 1);
+    default: qa_ast_error = 5; return 0;
+  }
+}
+
+/* COMMAND.line is deliberately NOT read: generic constructors do not set it.
+ * Compound control entries use their native test/body's first logical line.
+ */
+static int qa_ast_line(const COMMAND *command, unsigned depth)
+{
+  int first, second;
+  if (!command || depth > 2048) return 0;
+  switch (command->type) {
+    case cm_simple: return command->value.Simple->line;
+    case cm_for: return command->value.For->line;
+    case cm_select: return command->value.Select->line;
+    case cm_case: return command->value.Case->line;
+    case cm_function_def: return qa_function_source_line(command->value.Function_def);
+    case cm_subshell: return command->value.Subshell->line;
+    case cm_cond: return command->value.Cond->line;
+    case cm_arith: return command->value.Arith->line;
+    case cm_arith_for: return command->value.ArithFor->line;
+    case cm_group: return qa_ast_line(command->value.Group->command, depth + 1);
+    case cm_coproc: return qa_ast_line(command->value.Coproc->command, depth + 1);
+    case cm_while: case cm_until: return qa_ast_line(command->value.While->test, depth + 1);
+    case cm_if: return qa_ast_line(command->value.If->test, depth + 1);
+    case cm_connection:
+      first = qa_ast_line(command->value.Connection->first, depth + 1);
+      second = qa_ast_line(command->value.Connection->second, depth + 1);
+      return first > 0 ? first : second;
+    default: return 0;
+  }
+}
+
+static void qa_inventory_tree(const COMMAND *, const char *, unsigned);
+static void qa_source_words(const COMMAND *, const char *, unsigned);
+
+static void qa_inventory_child(const COMMAND *command, const char *parent, const char *edge, unsigned depth)
+{
+  EVP_MD_CTX *context;
+  unsigned char value[32];
+  unsigned length;
+  char digest[65];
+  if (!command) return;
+  context = EVP_MD_CTX_new();
+  if (!context || !EVP_DigestInit_ex(context, EVP_sha256(), NULL) ||
+      !EVP_DigestUpdate(context, parent, strlen(parent) + 1) ||
+      !EVP_DigestUpdate(context, edge, strlen(edge) + 1) ||
+      !EVP_DigestFinal_ex(context, value, &length) || length != 32) {
+    dropped = 1;
+  } else {
+    hex_digest(value, digest);
+    qa_inventory_tree(command, digest, depth);
+  }
+  if (context) EVP_MD_CTX_free(context);
+}
+
+/* Static branch metadata is independent of which commands later execute. */
+static void qa_branch_inventory(const COMMAND *command, const char *identity, int line)
+{
+  int tag = -1;
+  char record[320];
+  switch (command->type) {
+    case cm_if: tag = 0; break;
+    case cm_while: tag = 1; break;
+    case cm_until: tag = 2; break;
+    case cm_for: tag = 5; break;
+    case cm_connection:
+      if (command->value.Connection->connector == AND_AND) tag = 3;
+      else if (command->value.Connection->connector == OR_OR) tag = 4;
+      break;
+    default: break;
+  }
+  if (tag >= 0) {
+    snprintf(record, sizeof(record), "B7\tD\t%ld\t%s\t%d\t%d\t%s\t%d\n",
+             (long)getpid(), source_digest, line, command->type, identity, tag);
+    write_event(record);
+  }
+}
+
+static void qa_inventory_tree(const COMMAND *command, const char *identity, unsigned depth)
+{
+  const PATTERN_LIST *pattern;
+  char record[320], edge[64];
+  int line, index;
+  if (!command) return;
+  if (depth > 2048) { dropped = 1; return; }
+  line = qa_ast_line(command, 0) + qa_entry_offset;
+  if (qa_entries_mode) line = qa_authored_line(identity, command->type, line);
+  if (line <= 0) {
+    dropped = 1;
+    snprintf(record, sizeof(record), "B2\tX\t%ld\t%s\t6\t%d\t%d\n", (long)getpid(), source_digest, command->type, line);
+    write_event(record);
+  } else {
+    qa_origin_register(command, identity, line);
+    if (qa_entries_mode) qa_source_words(command, identity, depth);
+    snprintf(record, sizeof(record), "B2\tI\t%ld\t%s\t%d\t%d\t%s\n",
+             (long)getpid(), source_digest, line, command->type, identity);
+    if (!qa_functions_mode || command->type == cm_function_def) write_event(record);
+    if (!qa_functions_mode && (!qa_entries_mode || qa_decisions_mode)) qa_branch_inventory(command, identity, line);
+  }
+  switch (command->type) {
+    case cm_simple:
+      if (qa_entries_mode) qa_trap_inventory(command, identity, line, depth);
+      break;
+    case cm_connection:
+      qa_inventory_child(command->value.Connection->first, identity, "sequence:first", depth + 1);
+      qa_inventory_child(command->value.Connection->second, identity, "sequence:second", depth + 1); break;
+    case cm_cond:
+      if (!qa_functions_mode && (!qa_entries_mode || qa_decisions_mode)) qa_cond_root_inventory(command->value.Cond, identity, depth + 1);
+      break;
+    case cm_for: qa_inventory_child(command->value.For->action, identity, "for:body", depth + 1); break;
+    case cm_select: qa_inventory_child(command->value.Select->action, identity, "select:body", depth + 1); break;
+    case cm_while: case cm_until:
+      qa_inventory_child(command->value.While->test, identity, "loop:test", depth + 1);
+      qa_inventory_child(command->value.While->action, identity, "loop:body", depth + 1); break;
+    case cm_if:
+      qa_inventory_child(command->value.If->test, identity, "if:test", depth + 1);
+      qa_inventory_child(command->value.If->true_case, identity, "if:then", depth + 1);
+      qa_inventory_child(command->value.If->false_case, identity, "if:else", depth + 1); break;
+    case cm_case:
+      for (pattern = command->value.Case->clauses, index = 0; pattern; pattern = pattern->next, index++) {
+        if (!qa_functions_mode && (!qa_entries_mode || qa_decisions_mode)) qa_case_inventory(pattern, identity, line, index);
+        snprintf(edge, sizeof(edge), "case:clause:%d", index);
+        qa_inventory_child(pattern->action, identity, edge, depth + 1);
+      }
+      break;
+    case cm_function_def:
+      qa_inventory_child(command->value.Function_def->command, identity, "function:body", depth + 1);
+      qa_mark_function(command->value.Function_def, identity);
+      break;
+    case cm_group: qa_inventory_child(command->value.Group->command, identity, "group:body", depth + 1); break;
+    case cm_subshell: qa_inventory_child(command->value.Subshell->command, identity, "subshell:body", depth + 1); break;
+    case cm_coproc: qa_inventory_child(command->value.Coproc->command, identity, "coprocess:body", depth + 1); break;
+    case cm_arith:
+      if (qa_decisions_mode) qa_arithmetic_word_inventory(command->value.Arith->exp, identity, "arithmetic:expression", line);
+      break;
+    case cm_arith_for:
+      if (qa_decisions_mode) {
+        qa_arithmetic_word_inventory(command->value.ArithFor->init, identity, "arithmetic:init", line);
+        qa_arithmetic_word_inventory(command->value.ArithFor->test, identity, "arithmetic:test", line);
+        qa_arithmetic_word_inventory(command->value.ArithFor->step, identity, "arithmetic:step", line);
+      }
+      qa_inventory_child(command->value.ArithFor->action, identity, "arithmetic_for:body", depth + 1); break;
+    default: break;
+  }
+}
