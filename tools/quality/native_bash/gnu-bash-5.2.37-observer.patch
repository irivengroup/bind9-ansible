+/* Every registered native source site must receive retained-word provenance.
+ * These are DECLARATIONS, never hits. Unknown owners preserve a refusal. */
+static void qa_word_owner_census(void)
+{
+  unsigned index;
+  QA_SUBSTITUTION_ORIGIN *site;
+  char record[400];
+  for (index = 0; index < qa_substitution_count; index++) {
+    site = &qa_substitutions[index];
+    if (!site->owner[0] || !site->owner_rank) { dropped = 1; continue; }
+    snprintf(record, sizeof(record), "W2\tI\t%ld\t%s\t%s\t%s\t%s\t%u\n",
+             (long)getpid(), source_digest, site->identity, site->owner, site->shape, site->owner_rank);
+    write_event(record);
+  }
+}
