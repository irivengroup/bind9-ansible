+static int qa_name_digest(const char *name, char output[65])
+{
+  EVP_MD_CTX *context = EVP_MD_CTX_new();
+  unsigned char value[32];
+  unsigned length;
+  int result = 0;
+  if (context && EVP_DigestInit_ex(context, EVP_sha256(), NULL) &&
+      EVP_DigestUpdate(context, name, strlen(name) + 1) &&
+      EVP_DigestFinal_ex(context, value, &length) && length == 32) {
+    hex_digest(value, output);
+    result = 1;
+  }
+  if (context) EVP_MD_CTX_free(context);
+  return result;
+}
