+static void qa_cond_root_inventory(const COND_COM *condition, const char *parent, unsigned depth)
+{
+  char identity[65];
+  if (!qa_edge_digest(parent, "conditional:root", identity)) { dropped = 1; return; }
+  qa_cond_tree_inventory(condition, identity, depth);
+}
