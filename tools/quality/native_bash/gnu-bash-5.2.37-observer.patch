+static void write_event(const char *event)
+{
+  static uint64_t blocked_nanoseconds;
+  static pid_t waiting_pid;
+  size_t length = strlen(event);
+  ssize_t count;
+  struct pollfd ready;
+  struct timespec before, after;
+  uint64_t elapsed, remaining;
+  int result, milliseconds;
+  if (++events > 1000000) { dropped = 1; return; }
+  if (qa_sets_mode) {
+    result = qa_event_duplicate(event);
+    if (result < 0) { dropped = 1; return; }
+    if (result) return;
+  }
+  if (waiting_pid != getpid()) { waiting_pid = getpid(); blocked_nanoseconds = 0; }
+  for (;;) {
+    count = send(output_fd, event, length, MSG_DONTWAIT | MSG_NOSIGNAL);
+    if (count >= 0) { if ((size_t)count != length) dropped = 1; return; }
+    if (errno == EINTR) continue;
+    if (errno != EAGAIN && errno != EWOULDBLOCK) { dropped = 1; return; }
+    if (blocked_nanoseconds >= UINT64_C(5000000000)) { dropped = 1; return; }
+    remaining = UINT64_C(5000000000) - blocked_nanoseconds;
+    milliseconds = remaining >= UINT64_C(50000000) ? 50 : (int)((remaining + 999999) / 1000000);
+    ready.fd = output_fd; ready.events = POLLOUT; ready.revents = 0;
+    if (clock_gettime(CLOCK_MONOTONIC, &before) != 0) { dropped = 1; return; }
+    result = poll(&ready, 1, milliseconds);
+    if (clock_gettime(CLOCK_MONOTONIC, &after) != 0) { dropped = 1; return; }
+    elapsed = (uint64_t)(after.tv_sec - before.tv_sec) * UINT64_C(1000000000);
+    if (after.tv_nsec >= before.tv_nsec) elapsed += (uint64_t)(after.tv_nsec - before.tv_nsec);
+    else elapsed -= (uint64_t)(before.tv_nsec - after.tv_nsec);
+    blocked_nanoseconds += elapsed;
+    if (result < 0 || (ready.revents & (POLLERR | POLLHUP | POLLNVAL))) { dropped = 1; return; }
+  }
+}
