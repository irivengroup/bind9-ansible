+static void qa_process_header(void)
+{
+  char record[256];
+  qa_observer_pid = getpid();
+  events = 0;
+  snprintf(record, sizeof(record), "B1\tH\t%ld\t%s\n", (long)getpid(), source_digest);
+  write_event(record);
+  snprintf(record, sizeof(record), "B5\tM\t%ld\t%s\t%s\n", (long)getpid(), source_digest, qa_decisions_mode ? (qa_decision_raw ? "decision_raw" : "decision_sets") : (qa_functions_mode ? "function_sets" : (qa_entries_mode ? "entry_sets" : (qa_sets_mode ? "sets" : "raw"))));
+  write_event(record);
+}
+
+static void initialize(void)
+{
+  const char *descriptor, *allowed, *cursor, *mode;
+  char *end;
+  long fd;
+  struct stat metadata;
+  int type;
+  socklen_t size = sizeof(type), address_size = sizeof(struct sockaddr_un);
+  struct sockaddr_un address;
+  if (initialized) {
+    if (active && qa_observer_pid != getpid()) qa_process_header();
+    return;
+  }
+  initialized = 1;
+  mode = getenv("BIND9_NATIVE_BASH_EVENT_MODE");
+  if (mode && strcmp(mode, "raw") != 0 && strcmp(mode, "sets") != 0 &&
+      strcmp(mode, "function_sets") != 0 && strcmp(mode, "entry_sets") != 0 && strcmp(mode, "decision_sets") != 0 && strcmp(mode, "decision_raw") != 0) return;
+  qa_functions_mode = mode && strcmp(mode, "function_sets") == 0;
+  qa_decision_raw = mode && strcmp(mode, "decision_raw") == 0;
+  qa_decisions_mode = qa_decision_raw || (mode && strcmp(mode, "decision_sets") == 0);
+  qa_entries_mode = qa_decisions_mode || (mode && strcmp(mode, "entry_sets") == 0);
+  qa_sets_mode = !qa_decision_raw && (qa_functions_mode || qa_entries_mode || (mode && strcmp(mode, "sets") == 0));
+  descriptor = getenv("BIND9_NATIVE_BASH_FD");
+  allowed = getenv("BIND9_NATIVE_BASH_SHA256");
+  if (!descriptor || !*descriptor || !allowed || !shell_script_filename) return;
+  for (cursor = descriptor; *cursor; cursor++) if (*cursor < '0' || *cursor > '9') return;
+  fd = strtol(descriptor, &end, 10);
+  if (*end || fd < 10 || fd > 1023) return;
+  if (fstat(fd, &metadata) < 0 || !S_ISSOCK(metadata.st_mode) || metadata.st_uid != geteuid() ||
+      (metadata.st_mode & 0777) != 0600) return;
+  if (getsockopt(fd, SOL_SOCKET, SO_TYPE, &type, &size) < 0 || type != SOCK_DGRAM) return;
+  if (getsockname(fd, (struct sockaddr *)&address, &address_size) < 0 || address.sun_family != AF_UNIX) return;
+  if (!hash_file(shell_script_filename, source_digest)) return;
+  /* Accept complete 64-character digests, never a substring of another token. */
+  for (cursor = allowed; strlen(cursor) >= 64; cursor += 65) {
+    if (strncmp(cursor, source_digest, 64) == 0 && (cursor[64] == 0 || cursor[64] == ',')) {
+      active = 1; output_fd = (int)fd; break;
+    }
+    if (cursor[64] != ',') break;
+  }
+  if (active) {
+    int descriptor_flags = fcntl(output_fd, F_GETFD);
+    if (descriptor_flags < 0 || fcntl(output_fd, F_SETFD, descriptor_flags | FD_CLOEXEC) < 0) {
+      active = 0; output_fd = -1; return;
+    }
+    if (!qa_functions_mode && (!qa_entries_mode || qa_decisions_mode))
+      qa_terminal_setup();
+    qa_process_header();
+  }
+}
