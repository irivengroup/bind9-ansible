+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Research-only origins for native GNU command copies and their lifetimes.
+ * No command expansion, printed command buffer or shell variable is touched.
+ * Dynamic strings/arithmetics/embedded AWK remain unmeasured and unadmitted.
+ */
+#define QA_ORIGIN_CAPACITY 65536U
+#define QA_ORIGIN_LIMIT 32768U
+typedef struct qa_origin {
+  const COMMAND *node;
+  int line, kind, function_line, status_predicate;
+  unsigned lexical_tag;
+  int literal_arithmetic;
+  char word_digest[65];
+  char identity[65], function_identity[65], function_name[65];
+} QA_ORIGIN;
+static QA_ORIGIN qa_origins[QA_ORIGIN_CAPACITY];
+static unsigned qa_origin_count;
+static int qa_ast_line(const COMMAND *, unsigned);
+static int qa_name_digest(const char *, char [65]);
+
+static unsigned qa_origin_home(const COMMAND *node)
+{
+  uint64_t value = ((uint64_t)(uintptr_t)node >> 3) * UINT64_C(11400714819323198485);
+  return (unsigned)(value >> 48);
+}
+
+static QA_ORIGIN *qa_origin_lookup(const COMMAND *node, int create)
+{
+  unsigned index, count;
+  if (!node || !active) return NULL;
+  index = qa_origin_home(node);
+  for (count = 0; count < QA_ORIGIN_CAPACITY; count++, index = (index + 1) % QA_ORIGIN_CAPACITY) {
+    if (qa_origins[index].node == node) return &qa_origins[index];
