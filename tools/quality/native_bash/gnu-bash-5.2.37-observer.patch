+/* QA-only syntax inventory: native noeval blocks all lookup and assignment.
+ * Only original plain source words are admitted, never variable-derived text.
+ * Errors remain parser results without becoming native shell diagnostics. */
+/* This cleanup precedes restoration of the original evaluator pointers.
+ * A native nonlocal jump can leave a partially parsed private expression;
+ * it must not leak that state into a later real arithmetic evaluation. */
+static void qa_arithmetic_parse_cleanup(char *unused)
+{
+  if (expr_depth > 0) {
+    FREE(tokstr); FREE(expression);
+    tokstr = expression = (char *)NULL;
+    expr_unwind();
+    expr_depth = 0;
+  }
+}
+
+int qa_arithmetic_parse_only(const char *source)
+{
+  int saved_errno = errno, valid = 0;
+  if (!source || expr_depth || expression || tokstr || qa_inventory_pass) return 2;
+  begin_unwind_frame("qa_arithmetic_parse");
+  unwind_protect_var(noeval);
+  unwind_protect_var(already_expanded);
+  unwind_protect_var(curtok);
+  unwind_protect_var(lasttok);
+  unwind_protect_var(assigntok);
+  unwind_protect_var(tokval);
+  unwind_protect_var(expression);
+  unwind_protect_var(tp);
+  unwind_protect_var(lasttp);
+  unwind_protect_var(tokstr);
+  unwind_protect_var(curlval);
+  unwind_protect_var(lastlval);
+  unwind_protect_var(expr_depth);
+  unwind_protect_var(evalbuf);
+  unwind_protect_var(qa_inventory_pass);
+  add_unwind_protect(qa_arithmetic_parse_cleanup, (char *)NULL);
+  qa_inventory_pass = 1;
+  evalexp((char *)source, 0, &valid);
+  run_unwind_frame("qa_arithmetic_parse");
+  errno = saved_errno;
+  return valid ? 1 : 0;
+}
