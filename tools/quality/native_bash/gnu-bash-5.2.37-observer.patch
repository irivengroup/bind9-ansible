+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Native terminal-command completion with explicit child/parent provenance.
+ * T is emitted by the child immediately before its real exec handoff.
+ * W comes from that PID's own native wait status, never the compound parent's
+ * result. Existing source declarations and all transport limits are retained.
+ */
+static void qa_terminal_setup(void)
+{
+  void *memory = mmap(NULL,sizeof(QA_TERMINAL_MAP),PROT_READ|PROT_WRITE,
+                     MAP_SHARED|MAP_ANONYMOUS,-1,0);
+  if (memory == MAP_FAILED) { dropped = 1; return; }
+  qa_terminal_map = memory;
+}
+
+void qa_terminal_exec_begin(const COMMAND *command)
+{
+  int saved_errno = errno;
+  QA_ORIGIN *origin;
+  QA_TERMINAL_SLOT *slot;
+  unsigned index, serial;
+  unsigned long long expected, claimed;
+  char record[320];
+  initialize();
+  if (!active || qa_functions_mode || (qa_entries_mode && !qa_decisions_mode) ||
+      !command || command->type != cm_simple || (command->flags & CMD_INVERT_RETURN))
+    goto done;
+  origin = qa_origin_lookup(command,0);
+  if (!origin || !origin->status_predicate) goto done;
+  if (!qa_terminal_map) goto refused;
+  serial = __atomic_add_fetch(&qa_terminal_map->serial,1,__ATOMIC_RELAXED);
+  if (!serial || serial > 2147483647U) goto refused;
+  for (index=0;index<QA_TERMINAL_CAPACITY;index++) {
+    slot = &qa_terminal_map->slots[index];
+    expected = 0;
+    claimed = ((unsigned long long)serial << 2) | 1ULL;
+    if (!__atomic_compare_exchange_n(&slot->state,&expected,claimed,0,
+          __ATOMIC_ACQ_REL,__ATOMIC_RELAXED)) continue;
+    slot->serial=serial;
+    __atomic_store_n(&slot->child,getpid(),__ATOMIC_RELAXED);
+    __atomic_store_n(&slot->parent,getppid(),__ATOMIC_RELAXED);
+    slot->line=origin->line; slot->kind=origin->kind;
+    memcpy(slot->identity,origin->identity,65);
+    snprintf(record,sizeof(record),"B10\tT\t%ld\t%s\t%d\t%d\t%s\t%ld\t%u\n",
+      (long)getpid(),source_digest,slot->line,slot->kind,slot->identity,
+      (long)__atomic_load_n(&slot->parent,__ATOMIC_RELAXED),serial);
+    write_event(record);
+    __atomic_store_n(&slot->state,((unsigned long long)serial << 2) | 2ULL,
+                     __ATOMIC_RELEASE);
+    goto done;
+  }
+refused:
+  dropped = 1;
+  snprintf(record,sizeof(record),"B10\tU\t%ld\t%s\t1\n",(long)getpid(),source_digest);
+  write_event(record);
+done:
+  errno = saved_errno;
+}
+
+void qa_terminal_exec_status(pid_t child, int status)
+{
+  int saved_errno = errno;
+  unsigned index;
+  unsigned long long observed, expected;
+  QA_TERMINAL_SLOT *slot;
+  char record[320];
+  initialize();
+  if (!active || !qa_terminal_map || status < 0 || status > 255) goto done;
+  for (index=0;index<QA_TERMINAL_CAPACITY;index++) {
+    slot = &qa_terminal_map->slots[index];
+    observed = __atomic_load_n(&slot->state,__ATOMIC_ACQUIRE);
+    if ((observed & 3ULL) != 2ULL ||
+        __atomic_load_n(&slot->child,__ATOMIC_RELAXED) != child ||
+        __atomic_load_n(&slot->parent,__ATOMIC_RELAXED) != getpid()) continue;
+    /* Claim this exact generation before reading non-atomic source fields.
+     * A different parent can retire/reuse another slot during this scan; an
+     * atomic generation comparison prevents mixing either slot's identity. */
+    expected = observed;
+    if (!__atomic_compare_exchange_n(&slot->state,&expected,
+          (observed & ~3ULL) | 3ULL,0,__ATOMIC_ACQ_REL,__ATOMIC_RELAXED)) continue;
+    snprintf(record,sizeof(record),"B10\tW\t%ld\t%s\t%d\t%d\t%s\t%ld\t%u\t%d\n",
+      (long)getpid(),source_digest,slot->line,slot->kind,slot->identity,
+      (long)child,slot->serial,status);
+    write_event(record);
+    __atomic_store_n(&slot->state,0,__ATOMIC_RELEASE);
+  }
+done:
+  errno = saved_errno;
+}
