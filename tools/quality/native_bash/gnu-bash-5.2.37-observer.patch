+  if (!token || token != qa_word_arithmetic_pending_depth) { dropped = 1; goto done; }
+  site = qa_word_arithmetic + qa_word_arithmetic_pending[token-1].site;
+  if (qa_arithmetic_ast_runtime != 2 || strcmp(qa_arithmetic_owner,site->identity)) dropped = 1;
+  else qa_arithmetic_owned_result(valid,truth);
+  run_unwind_frame("qa_arithmetic_word_expansion");
+done:
+  errno = saved_errno;
+}
