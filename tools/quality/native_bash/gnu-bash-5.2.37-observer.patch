+static void hex_digest(const unsigned char *value, char *output)
+{
+  static const char digits[] = "0123456789abcdef";
+  unsigned int index;
+  for (index = 0; index < 32; index++) {
+    output[index * 2] = digits[value[index] >> 4];
+    output[index * 2 + 1] = digits[value[index] & 15];
+  }
+  output[64] = 0;
+}
+
+static int hash_file(const char *path, char *output)
+{
+  int fd, result = 0;
+  ssize_t count;
+  unsigned long total = 0;
+  unsigned char buffer[8192], digest[32];
+  unsigned int length;
+  struct stat metadata;
+  EVP_MD_CTX *context = NULL;
+  fd = open(path, O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+  if (fd < 0) return 0;
+  if (fstat(fd, &metadata) < 0 || !S_ISREG(metadata.st_mode) || metadata.st_size > 4194304) goto done;
+  context = EVP_MD_CTX_new();
+  if (!context || EVP_DigestInit_ex(context, EVP_sha256(), NULL) != 1) goto done;
+  while ((count = read(fd, buffer, sizeof(buffer))) != 0) {
+    if (count < 0) { if (errno == EINTR) continue; goto done; }
+    total += count;
+    if (total > 4194304 || EVP_DigestUpdate(context, buffer, count) != 1) goto done;
+  }
+  if (EVP_DigestFinal_ex(context, digest, &length) != 1 || length != 32) goto done;
+  hex_digest(digest, output);
+  result = 1;
+done:
+  if (context) EVP_MD_CTX_free(context);
+  close(fd);
+  return result;
+}
