+static int hash_word(EVP_MD_CTX *context, const WORD_DESC *word)
+{
+  const char *value = word ? word->word : "";
+  return EVP_DigestUpdate(context, value, strlen(value) + 1) == 1;
+}
+
+static int site_digest(const COND_COM *condition, char *output)
+{
+  unsigned char digest[32];
+  unsigned int length;
+  EVP_MD_CTX *context = EVP_MD_CTX_new();
+  int result = 0;
+  if (!context || EVP_DigestInit_ex(context, EVP_sha256(), NULL) != 1) goto done;
+  if (!hash_word(context, condition->op) ||
+      !hash_word(context, condition->left ? condition->left->op : NULL) ||
+      !hash_word(context, condition->right ? condition->right->op : NULL)) goto done;
+  if (EVP_DigestFinal_ex(context, digest, &length) != 1 || length != 32) goto done;
+  hex_digest(digest, output);
+  result = 1;
+done:
+  if (context) EVP_MD_CTX_free(context);
+  return result;
+}
