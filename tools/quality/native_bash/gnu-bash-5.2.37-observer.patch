+/* Per-object runtime origins and immutable authored positions have different
+ * lifetimes: native source subtrees are disposed after parsing. Preserve their
+ * positions by exact structural ID so reparsing cannot invent line coverage. */
+#define QA_SOURCE_CAPACITY 65536U
+#define QA_SOURCE_LIMIT 32768U
+static struct { char identity[65]; int line, kind; } qa_source_sites[QA_SOURCE_CAPACITY];
+static unsigned qa_source_count;
+static int qa_authored_line(const char *identity, int kind, int line)
+{
+  unsigned index, count;
+  uint64_t hash = UINT64_C(14695981039346656037);
+  for (index = 0; index < 64; index++) hash = (hash ^ (unsigned char)identity[index]) * UINT64_C(1099511628211);
+  index = (unsigned)(hash % QA_SOURCE_CAPACITY);
+  for (count = 0; count < QA_SOURCE_CAPACITY; count++, index = (index + 1) % QA_SOURCE_CAPACITY) {
+    if (!qa_source_sites[index].identity[0]) {
+      if (qa_rebinding || line <= 0 || qa_source_count == QA_SOURCE_LIMIT) { dropped = 1; return 0; }
+      memcpy(qa_source_sites[index].identity, identity, 65);
+      qa_source_sites[index].kind = kind;
+      qa_source_sites[index].line = line;
+      qa_source_count++;
+      return line;
+    }
+    if (!strcmp(qa_source_sites[index].identity, identity)) {
+      if (qa_source_sites[index].kind != kind || (!qa_rebinding && qa_source_sites[index].line != line)) {
+        dropped = 1; return 0;
+      }
+      return qa_source_sites[index].line;
+    }
+  }
+  dropped = 1;
+  return 0;
+}
