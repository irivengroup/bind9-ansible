+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Research-only native control decisions. The interpreter supplies its existing
+ * result; no shell expression, expansion, DEBUG trap or test runs a second time.
+ * Dynamic origins and arithmetic/AWK still prevent complete shell admission.
+ */
+void qa_branch_result(const COMMAND *command, int tag, int outcome)
+{
+  int saved_errno = errno;
+  QA_ORIGIN *origin;
+  char record[320];
+  initialize();
+  if (active && !qa_functions_mode && (!qa_entries_mode || qa_decisions_mode)) {
+    origin = qa_origin_lookup(command, 0);
+    if (origin) {
+      snprintf(record, sizeof(record), "B2\tR\t%ld\t%s\t%d\t%d\t%s\t%d\t%d\n",
+               (long)getpid(), source_digest, origin->line, origin->kind, origin->identity, tag, outcome);
+    } else {
+      snprintf(record, sizeof(record), "B2\tV\t%ld\t%s\t%d\t%d\t%d\t%d\n",
+               (long)getpid(), source_digest, qa_ast_line(command, 0), command->type, tag, outcome);
+    }
+    write_event(record);
+  }
+  errno = saved_errno;
+}
+
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Passive native command status facts from GNU execution. R is the interpreter's
+ * already computed result before ! inversion; O is its actual normal return
+ * after pending traps. Nonlocal jumps/exec paths are not inferred from parents.
+ */
+void qa_command_status(const COMMAND *command, int result, int phase)
+{
+  int saved_errno = errno;
+  QA_ORIGIN *origin;
+  char record[320];
+  initialize();
+  if (active && !qa_functions_mode && (!qa_entries_mode || qa_decisions_mode) && command) {
+    origin = qa_origin_lookup(command, 0);
+    if (origin) {
+      snprintf(record, sizeof(record), "B8\t%c\t%ld\t%s\t%d\t%d\t%s\t%d\n",
+               phase == 0 ? 'R' : 'O', (long)getpid(), source_digest,
+               origin->line, origin->kind, origin->identity, result);
+    } else {
+      snprintf(record, sizeof(record), "B8\tU\t%ld\t%s\t%d\t%d\t%d\t%d\n",
+               (long)getpid(), source_digest, qa_ast_line(command, 0), command->type, result, phase);
+    }
+    write_event(record);
+  }
+  errno = saved_errno;
+}
+
+/* Closed literal-trap provenance. Only the two source-pinned role scripts
+ * may register these exact literal handlers. Native parsing is non-evaluating
+ * and isolated by Bash's saved parser state. Body declarations stay static;
+ * execution/result hooks provide hits separately. Arbitrary eval and dynamic
+ * trap bodies remain refused.
+ */
+#define QA_LITERAL_TRAPS 32
+typedef struct qa_literal_trap {
+  char parent[65], identity[65], shape[65], text[4097];
+  int line;
+} QA_LITERAL_TRAP;
+static QA_LITERAL_TRAP qa_literal_traps[QA_LITERAL_TRAPS];
+static unsigned qa_literal_trap_count;
+static unsigned qa_signal_traps[NSIG + 3];
+
+static int qa_closed_traps(void)
+{
+  return qa_entries_mode &&
+    (!strcmp(source_digest, "735a0ba1dc0080b85b650aae54940ed754f87075c0a0bf7242fe24b3407c0b85") ||
+     !strcmp(source_digest, "c9d84ecf4261274867b7e655c5f246b41f05629e389fffd9fc1b9193aa280b60"));
+}
+
+static int qa_closed_trap_command(const COMMAND *command, const char *parent)
+{
+  const WORD_LIST *words;
+  unsigned index;
+  if (!qa_closed_traps() || command->type != cm_simple) return 0;
+  words = command->value.Simple->words;
+  if (!words || !words->word || strcmp(words->word->word,"trap")) return 0;
+  words = words->next;
+  if (!words || !words->word) return 0;
+  if (!strcmp(words->word->word,"-") && words->word->flags == 0 && words->next) {
+    for (words = words->next; words; words = words->next)
+      if (!words->word || words->word->flags != 0) return 0;
+    return 1;
+  }
+  for (index = 0; index < qa_literal_trap_count; index++)
+    if (!strcmp(qa_literal_traps[index].parent,parent)) return 1;
+  return 0;
+}
+
+static void qa_trap_inventory(const COMMAND *command, const char *parent, int line, unsigned depth)
+{
+  const WORD_LIST *words = command->value.Simple->words;
+  char *body;
+  COMMAND *tree;
+  QA_LITERAL_TRAP *slot;
+  unsigned index;
+  int offset;
+  if (!qa_closed_traps() || !words || !words->word || strcmp(words->word->word, "trap")) return;
+  words = words->next;
+  if (!words || !words->word || !strcmp(words->word->word, "-")) return;
+  if (qa_entry_offset || strlen(words->word->word) > 4096) { dropped = 1; return; }
+  for (index = 0; index < qa_literal_trap_count; index++)
+    if (!strcmp(qa_literal_traps[index].parent, parent)) return;
+  if (qa_literal_trap_count == QA_LITERAL_TRAPS) { dropped = 1; return; }
+  /* The closed sources use single-quoted literal bodies, not expanded words. */
+  body = string_quote_removal(words->word->word, 0);
+  if (!body || strlen(body) > 4096) { free(body); dropped = 1; return; }
+  qa_parsing_trap = 1;
+  tree = parse_string_to_command(body, SX_COMPLETE | SX_NOLONGJMP);
+  qa_parsing_trap = 0;
+  if (!tree) { free(body); dropped = 1; return; }
+  slot = &qa_literal_traps[qa_literal_trap_count];
+  if (!qa_edge_digest(parent, "constant-trap:body", slot->identity) ||
+      !qa_substitution_shape(tree, slot->shape)) {
+    dispose_command(tree); free(body); dropped = 1; return;
+  }
+  memcpy(slot->parent, parent, 65);
+  memcpy(slot->text, body, strlen(body) + 1);
+  slot->line = line;
+  qa_literal_trap_count++;
+  offset = qa_entry_offset;
+  qa_entry_offset = line - qa_ast_line(tree, 0);
+  qa_inventory_tree(tree, slot->identity, depth + 1);
+  qa_boolean_tree(tree,0,depth+1);
+  qa_entry_offset = offset;
+  dispose_command(tree);
+  free(body);
+}
+
+void qa_trap_binding(int signal, const char *body)
+{
+  int saved_errno = errno;
+  QA_ORIGIN *origin;
+  unsigned index;
+  initialize();
+  if (!active || !qa_closed_traps()) goto done;
+  if (signal < 0 || signal >= NSIG + 3 || !body) { dropped = 1; goto done; }
+  origin = qa_origin_lookup(qa_current_entry, 0);
+  if (origin) {
+    for (index = 0; index < qa_literal_trap_count; index++) {
+      if (strcmp(origin->identity, qa_literal_traps[index].parent)) continue;
+      if (strcmp(body, qa_literal_traps[index].text)) { dropped = 1; goto done; }
+      qa_signal_traps[signal] = index + 1;
+      goto done;
+    }
+  }
+  /* Bash also reinstalls inherited handlers internally. Keep only an exact
+   * previously observed native binding; never attribute a new arbitrary body. */
+  index = qa_signal_traps[signal];
+  if (!index || strcmp(body, qa_literal_traps[index - 1].text)) dropped = 1;
+done:
+  errno = saved_errno;
+}
+
+static int qa_trap_rebind(const COMMAND *command, const char *tag)
+{
+  unsigned binding;
+  int signal, offset, binding_state;
+  char shape[65];
+  QA_LITERAL_TRAP *slot;
+  /* GNU run_interrupt_trap uses its own tag for the same bound handler. */
+  if (strcmp(tag, "trap") && strcmp(tag, "exit trap") &&
+      strcmp(tag, "interrupt trap")) return 0;
+  if (!qa_closed_traps() || running_trap <= 0) { dropped = 1; return 1; }
+  signal = running_trap - 1;
+  if (!strcmp(tag, "interrupt trap") && signal != SIGINT) { dropped = 1; return 1; }
+  if (signal >= NSIG + 3 || !(binding = qa_signal_traps[signal])) { dropped = 1; return 1; }
+  slot = &qa_literal_traps[binding - 1];
+  if (!qa_substitution_shape(command, shape) || strcmp(shape, slot->shape)) { dropped = 1; return 1; }
+  offset = qa_entry_offset;
+  qa_entry_offset = slot->line - qa_ast_line(command, 0);
+  binding_state = qa_rebinding;
+  qa_rebinding = 1;
+  qa_inventory_tree(command, slot->identity, 0);
+  qa_rebinding = binding_state;
+  qa_entry_offset = offset;
+  return 1;
+}
