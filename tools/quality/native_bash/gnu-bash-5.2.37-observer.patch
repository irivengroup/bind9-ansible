+void qa_cond_inventory(const COND_COM *condition)
+{
+  int saved_errno = errno;
+  char site[65], line[320];
+  initialize();
+  if (active && !qa_functions_mode && !qa_entries_mode && (condition->type == COND_UNARY || condition->type == COND_BINARY)) {
+    if (site_digest(condition, site)) {
+      snprintf(line, sizeof(line), "B1\tI\t%ld\t%s\t%d\t%d\t%s\n",
+               (long)getpid(), source_digest, condition->line, condition->type, site);
+      write_event(line);
+    } else dropped = 1;
+  }
+  errno = saved_errno;
+}
+
+void qa_cond_result(const COND_COM *condition, int result)
+{
+  int saved_errno = errno;
+  char site[65], line[320];
+  initialize();
+  if (active && !qa_functions_mode && !qa_entries_mode && (condition->type == COND_UNARY || condition->type == COND_BINARY)) {
+    if (site_digest(condition, site)) {
+      snprintf(line, sizeof(line), "B1\tC\t%ld\t%s\t%d\t%d\t%s\t%d\n",
+               (long)getpid(), source_digest, condition->line, condition->type, site, result == EXECUTION_SUCCESS);
+      write_event(line);
+    } else dropped = 1;
+  }
+  errno = saved_errno;
+}
+
+void qa_probe_finish(int status)
+{
+  int saved_errno = errno;
+  char current[65], line[320];
+  initialize();
+  if (active) {
+    if (qa_entries_mode) qa_word_owner_census();
+    if (qa_decisions_mode) qa_arithmetic_word_census();
+    if (!hash_file(shell_script_filename, current) || strcmp(current, source_digest) != 0) dropped = 1;
+    snprintf(line, sizeof(line), "B1\tE\t%ld\t%s\t%d\t%d\n", (long)getpid(), source_digest, dropped, status);
+    write_event(line);
+  }
+  errno = saved_errno;
+}
