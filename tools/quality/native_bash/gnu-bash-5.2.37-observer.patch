+/* Hash literal source bytes plus the same terminating NUL as lexical sites.
+ * This never creates or evaluates a shell string and uses no variable values. */
+static int qa_parameter_span_digest(const char *input, size_t length, char output[65])
+{
+  EVP_MD_CTX *context = EVP_MD_CTX_new();
+  unsigned char digest[32];
