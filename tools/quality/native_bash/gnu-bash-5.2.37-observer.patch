+static void qa_cond_tree_inventory(const COND_COM *condition, const char *identity, unsigned depth)
+{
+  QA_ORIGIN *origin;
+  char record[320], child[65];
+  if (!condition) return;
+  if (depth > 2048 || condition->line <= 0) { dropped = 1; return; }
+  origin = qa_origin_lookup((const COMMAND *)condition, 1);
+  if (!origin) return;
+  if (origin->identity[0] && strcmp(origin->identity, identity) != 0) { dropped = 1; return; }
+  memcpy(origin->identity, identity, 65);
+  origin->kind = 100 + condition->type;
+  origin->line = qa_decisions_mode ? qa_authored_line(identity, origin->kind, condition->line + qa_entry_offset) : condition->line;
+  snprintf(record, sizeof(record), "B3\tI\t%ld\t%s\t%d\t%d\t%s\n",
+           (long)getpid(), source_digest, origin->line, origin->kind, origin->identity);
+  write_event(record);
+  if (!qa_edge_digest(identity, "conditional:left", child)) { dropped = 1; return; }
+  qa_cond_tree_inventory(condition->left, child, depth + 1);
+  if (!qa_edge_digest(identity, "conditional:right", child)) { dropped = 1; return; }
+  qa_cond_tree_inventory(condition->right, child, depth + 1);
+}
