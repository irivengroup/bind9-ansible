+/* This is a closed leaf recognizer, not a second arithmetic parser. Only
+ * named/positional parameters, argument count and named scalar/array length
+ * become a single numeric placeholder. GNU still parses every operator.
+ * Values, defaults, command substitutions and indirection are never expanded. */
+static char *qa_arithmetic_static_text(const char *source)
+{
+  size_t length = strlen(source), at = 0, used = 0, end, start;
+  char *output;
+  if (length > 1048576 || qa_arithmetic_offsets) return NULL;
+  output = malloc(length + 1);
+  qa_arithmetic_offsets = malloc((length + 1) * sizeof(int));
+  if (!output || !qa_arithmetic_offsets) {
+    free(output); free(qa_arithmetic_offsets); qa_arithmetic_offsets = NULL;
+    return NULL;
+  }
+  while (at < length) {
+    start = at;
+    if (source[at] == '\x60' || source[at] == '\\' || source[at] == '"' || source[at] == '\'')
+      goto unsupported;
+    if (source[at] != '$') {
+      qa_arithmetic_offsets[used] = (int)at;
+      output[used++] = source[at++];
+      continue;
+    }
+    end = at + 1;
+    if (source[end] == '#' || (source[end] >= '0' && source[end] <= '9')) end++;
+    else if (qa_arithmetic_name_start((unsigned char)source[end])) {
+      for (end++; qa_arithmetic_name_char((unsigned char)source[end]); end++) ;
+    } else if (source[end] == '{' && source[end + 1] == '#' &&
+               qa_arithmetic_name_start((unsigned char)source[end + 2])) {
+      for (end += 3; qa_arithmetic_name_char((unsigned char)source[end]); end++) ;
+      if (source[end] == '[') {
+        if (source[end + 1] != '@' || source[end + 2] != ']') goto unsupported;
+        end += 3;
+      }
+      if (source[end] != '}') goto unsupported;
+      end++;
+    } else if (source[end] == '{' && qa_arithmetic_name_start((unsigned char)source[end+1])) {
+      for (end += 2; qa_arithmetic_name_char((unsigned char)source[end]); end++) ;
+      if (source[end] == '[') {
+        size_t index = ++end;
+        int named = qa_arithmetic_name_start((unsigned char)source[end]);
+        if (!named && !(source[end] >= '0' && source[end] <= '9')) goto unsupported;
+        for (end++; (source[end] >= '0' && source[end] <= '9') ||
+             (named && qa_arithmetic_name_char((unsigned char)source[end])); end++) ;
