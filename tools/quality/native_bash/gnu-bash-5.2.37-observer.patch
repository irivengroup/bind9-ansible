+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Research-only case decisions. Match results come directly from strmatch;
+ * arm entry is distinct from evaluating a pattern (notably ;& fallthrough).
+ */
+static void qa_case_inventory(const PATTERN_LIST *clause, const char *parent, int line, int index)
+{
+  QA_ORIGIN *origin;
+  const WORD_LIST *pattern;
+  char edge[64], identity[65], child[65], record[320];
+  int position;
+  snprintf(edge, sizeof(edge), "case:clause:%d:control", index);
+  if (!qa_edge_digest(parent, edge, identity)) { dropped = 1; return; }
+  origin = qa_origin_lookup((const COMMAND *)clause, 1);
+  if (!origin) return;
+  if (origin->identity[0] && strcmp(origin->identity, identity) != 0) { dropped = 1; return; }
+  memcpy(origin->identity, identity, 65);
+  origin->line = line;
+  origin->kind = 201;
+  snprintf(record, sizeof(record), "B4\tI\t%ld\t%s\t%d\t201\t%s\n",
+           (long)getpid(), source_digest, line, identity);
+  write_event(record);
+  for (pattern = clause->patterns, position = 0; pattern; pattern = pattern->next, position++) {
+    snprintf(edge, sizeof(edge), "case:pattern:%d", position);
+    if (!qa_edge_digest(identity, edge, child)) { dropped = 1; return; }
+    snprintf(record, sizeof(record), "B4\tI\t%ld\t%s\t%d\t202\t%s\n",
+             (long)getpid(), source_digest, line, child);
+    write_event(record);
+    /* A quoted/escaped/expanded star is NOT an unconditional native glob.
+     * Keep this explicit provenance separate from observed pattern outcomes.
+     * No branch or condition is excluded by this research-only metadata. */
+    snprintf(record, sizeof(record), "B6\tP\t%ld\t%s\t%d\t202\t%s\t%d\n",
+             (long)getpid(), source_digest, line, child,
+             pattern->word && pattern->word->flags == 0 && strcmp(pattern->word->word, "*") == 0);
+    write_event(record);
+  }
+}
